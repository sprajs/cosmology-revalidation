{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reproducible experiment packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "question",
    "origin",
    "assumptions",
    "limitations",
    "inputs",
    "execution",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "runnable",
        "blocked"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "description"
          ],
          "properties": {
            "kind": {
              "const": "development_smoke"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "repository",
            "revision",
            "path",
            "snapshot",
            "sha256"
          ],
          "properties": {
            "kind": {
              "const": "prospector_candidate"
            },
            "repository": {
              "const": "sprajs/prospector"
            },
            "revision": {
              "$ref": "#/$defs/revision"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "snapshot": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            }
          }
        }
      ]
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "role",
          "semantics",
          "source"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "role": {
            "enum": [
              "observation",
              "released_fitted_summary",
              "derived_input",
              "synthetic_control"
            ]
          },
          "semantics": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine_revision",
            "operation",
            "request",
            "assurance",
            "timeout_seconds"
          ],
          "properties": {
            "engine_revision": {
              "$ref": "#/$defs/revision"
            },
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "interface": {
              "enum": [
                "cli",
                "native_lcdm_baseline"
              ]
            },
            "request": {
              "type": "string",
              "minLength": 1
            },
            "assurance": {
              "enum": [
                "numerical_contract",
                "qualified"
              ]
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          }
        }
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "request_sha256": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "runnable"
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "type": "object"
          },
          "blockers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "type": "null"
          },
          "blockers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "request_sha256"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      }
    }
  ]
}
