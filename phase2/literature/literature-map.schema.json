{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:supernova:phase2:literature-map:1",
  "type": "object",
  "required": [
    "schema_version",
    "built_at_utc",
    "scope",
    "entries",
    "preregistered_tests"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "source_url",
          "exact_version",
          "sources",
          "reading_status",
          "methods_read",
          "claim",
          "data_level",
          "likelihood",
          "assumptions",
          "priors",
          "sample_reuse",
          "known_critiques",
          "counterevidence",
          "reproduction",
          "preregistered_tests",
          "roles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "minLength": 1
          },
          "exact_version": {
            "type": "string",
            "minLength": 1
          },
          "reading_status": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "data_level": {
            "type": "string",
            "minLength": 1
          },
          "likelihood": {
            "type": "string",
            "minLength": 1
          },
          "priors": {
            "type": "string",
            "minLength": 1
          },
          "sample_reuse": {
            "type": "string",
            "minLength": 1
          },
          "known_critiques": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counterevidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preregistered_tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "methods_read": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "scope",
                    "document",
                    "details"
                  ]
                }
              ]
            }
          },
          "assumptions": {
            "type": "object",
            "required": [
              "population",
              "dust",
              "age",
              "colour_stretch",
              "selection"
            ],
            "properties": {
              "population": {
                "type": "string",
                "minLength": 1
              },
              "dust": {
                "type": "string",
                "minLength": 1
              },
              "age": {
                "type": "string",
                "minLength": 1
              },
              "colour_stretch": {
                "type": "string",
                "minLength": 1
              },
              "selection": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "reproduction": {
            "type": "object",
            "required": [
              "status",
              "data_code",
              "exact_limits"
            ],
            "properties": {
              "status": {
                "type": "string"
              },
              "data_code": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exact_limits": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "preregistered_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "hypothesis",
          "design",
          "pass_condition",
          "status"
        ]
      }
    }
  }
}
