# Local environment and Python caches.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Frozen scientific inputs are restored and verified from provenance/inputs.json.
/data/
/downloads/
*.partial

# Publish the reference records; additional campaigns stay local until selected.
/results/*
!/results/README.md
!/results/baseline/
!/results/alternatives/
!/results/robustness/
*.npz
*.npy
# Byte-for-byte supplementary extracts are regenerated from the input archive.
/results/**/extracted/

# Original study execution, downloaded dependencies and generated products.
/.work/

# Regenerable object-level result tables stay local.
/results/**/*.csv
/results/**/*.dat
