 } // end of gridinterp_snoopy
 
+
+/* Output-only all-USRFUN support accounting. No optimizer/model/RNG changes.
+   MXLC_PLOT=0 in this prospective protocol excludes plotting-only evaluations. */
+#include <float.h>
+typedef struct {char cid[64]; unsigned long long n, bad, nonfinite;
+ double lo,hi,zlo,zhi,slo,shi;} PROSP_SUP;
+static PROSP_SUP prosp_sup[64];
+static int prosp_nsup=0,prosp_enabled=-1,prosp_first_bad=0;
+static void prosp_support_finish(void) {
+ int i; for(i=0;i<prosp_nsup;i++) {
+ PROSP_SUP *p=&prosp_sup[i];
+ printf("PROSP_SUPPORT %s %llu %llu %llu %.17g %.17g %.17g %.17g %.17g %.17g\n",
+ p->cid,p->n,p->bad,p->nonfinite,p->lo,p->hi,p->zlo,p->zhi,p->slo,p->shi);
+ } fflush(stdout);
+}
+void prosp_mean_support__(char *cid,int *iter,int *filt,int *epoch,
+ double *trest,double *tobs,double *z,double *D,double *shape,double *AV,double *RV) {
+ int i,finite,bad; double tlo,thi,slo,shi;
+ if(prosp_enabled<0) {prosp_enabled=getenv("PROSP_FIT_SUPPORT")!=NULL;
+  if(prosp_enabled) atexit(prosp_support_finish);}
+ if(!prosp_enabled) return;
+ tlo=SNGRID_SNOOPY.VALUE[IPAR_GRIDGEN_TREST][1];
+ thi=SNGRID_SNOOPY.VALUE[IPAR_GRIDGEN_TREST][SNGRID_SNOOPY.NBIN[IPAR_GRIDGEN_TREST]];
+ slo=SNGRID_SNOOPY.VALUE[IPAR_GRIDGEN_SHAPEPAR][1];
+ shi=SNGRID_SNOOPY.VALUE[IPAR_GRIDGEN_SHAPEPAR][SNGRID_SNOOPY.NBIN[IPAR_GRIDGEN_SHAPEPAR]];
+ for(i=0;i<prosp_nsup;i++) if(strcmp(prosp_sup[i].cid,cid)==0) break;
+ if(i==prosp_nsup) {
+  if(i>=64) {printf("PROSP_SUPPORT_OVERFLOW %s\n",cid);return;}
+  PROSP_SUP *p=&prosp_sup[prosp_nsup++];snprintf(p->cid,64,"%s",cid);
+  p->lo=p->zlo=p->slo=DBL_MAX;p->hi=p->zhi=p->shi=-DBL_MAX;
+ }
+ PROSP_SUP *p=&prosp_sup[i]; p->n++;
+ finite=isfinite(*trest)&&isfinite(*z)&&isfinite(*shape)&&isfinite(*D)&&isfinite(*AV)&&isfinite(*RV);
+ bad=!finite || *trest<tlo || *trest>thi || *shape<slo || *shape>shi || *z<0 || *z>0.699999988079071;
+ if(bad) p->bad++; if(!finite) p->nonfinite++;
+ if(*trest<p->lo)p->lo=*trest;if(*trest>p->hi)p->hi=*trest;
+ if(*z<p->zlo)p->zlo=*z;if(*z>p->zhi)p->zhi=*z;
+ if(*shape<p->slo)p->slo=*shape;if(*shape>p->shi)p->shi=*shape;
+ if(bad && !prosp_first_bad) {prosp_first_bad=1;
+  printf("PROSP_SUPPORT_FIRST_BAD %s %d %d %d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g\n",
+  cid,*iter,*filt,*epoch,*trest,*tobs,*z,*D,*shape,*AV,*RV,tlo,thi,slo,shi);fflush(stdout);}
+}
